# DEFAULT BOARD: ESP32-S3 SuperMini FH4R2 (4 MB QIO flash, 2 MB QUAD PSRAM, WS2812 on GPIO21).
# Generic devkit: add the overlay, see README "Boards". NO SECRETS HERE.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_OMI_BOARD_NAME="s3-supermini"

# Flash / partitions (4 MB, two OTA slots)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# 2 MB in-package QUAD PSRAM (not octal). Boot continues without it (smaller buffers).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Buffers sized for 2 MB PSRAM: live FIFO 1 MiB (~4 min of Opus) + backlog batch
# 512 x 440 B = 220 KiB, leaving ~800 KiB for WiFi/TLS/NimBLE spill.
CONFIG_OMI_LIVE_BUFFER_KB=1024
CONFIG_OMI_BACKLOG_BATCH_PACKETS=512

# Native USB-C: console on USB-Serial-JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WS2812 status LED on GPIO21 (from omi-bridge-firmware #6)
CONFIG_OMI_STATUS_LED_GPIO=21
CONFIG_OMI_STATUS_LED_WS2812=y
CONFIG_OMI_STATUS_LED_BRIGHTNESS=16

# Bluetooth: NimBLE central only
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=40
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LWIP_SNTP_MAX_SERVERS=2
